generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  authIssuer  String
  authSubject String
  email       String?
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  collections Collection[]
  bookmarks   Bookmark[]

  @@unique([authIssuer, authSubject], map: "users_auth_issuer_auth_subject_key")
}

model Collection {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(100)
  ownerId   String     @db.Uuid
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "collections_owner_created_id_idx")
}

model Bookmark {
  id           String     @id @default(uuid()) @db.Uuid
  url          String     @db.VarChar(2048)
  title        String     @db.VarChar(300)
  notes        String?    @db.VarChar(10000)
  collectionId String?    @db.Uuid
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  ownerId      String     @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "bookmarks_owner_created_id_idx")
  @@index([ownerId, collectionId, createdAt(sort: Desc), id(sort: Desc)], map: "bookmarks_owner_collection_created_id_idx")
}
