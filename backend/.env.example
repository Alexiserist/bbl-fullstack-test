# Keep this URL aligned with the PostgreSQL values in ../.env.
DATABASE_URL=postgresql://bbl_bookmarks:replace-with-local-password@localhost:5432/bbl_bookmarks?schema=public

PORT=3001
CORS_ORIGIN=http://localhost:3000

AUTH0_ISSUER=https://dev-yg.us.auth0.com/
AUTH0_AUDIENCE=https://bbl-candidate-test-api
AUTH0_CLIENT_ID=replace-with-assignment-client-id
# Set this to azp or client_id after inspecting the tenant's real API access-token profile.
AUTH0_CLIENT_CLAIM=azp
AUTH0_JWKS_URI=https://dev-yg.us.auth0.com/.well-known/jwks.json
AUTH0_USERINFO_URI=https://dev-yg.us.auth0.com/userinfo
USERINFO_TIMEOUT_MS=1500
